<?xml version="1.0"?>
<fdm_config name="BloxCraft BC-001" version="2.0" release="ALPHA">
  <fileheader><author>BloxCraft Airlines</author><filecreationdate>2026-11-18</filecreationdate><version>0.2</version><description>Experimental flight dynamics model for the wingless cubic BC-001.</description><note>Entertainment model only. Aerodynamic coefficients and virtual control moments are provisional and require in-simulator tuning. Mach 10 in 10 seconds is not validated.</note></fileheader>
  <metrics>
    <wingarea unit="M2">16.0</wingarea><wingspan unit="M">4.0</wingspan><chord unit="M">4.0</chord>
    <location name="AERORP" unit="M"><x>0</x><y>0</y><z>0</z></location>
    <location name="EYEPOINT" unit="M"><x>-0.6</x><y>0</y><z>1.4</z></location>
    <location name="VRP" unit="M"><x>0</x><y>0</y><z>0</z></location>
  </metrics>
  <mass_balance>
    <ixx unit="KG*M2">5200</ixx><iyy unit="KG*M2">5200</iyy><izz unit="KG*M2">5200</izz><ixz unit="KG*M2">0</ixz><emptywt unit="KG">2800</emptywt>
    <location name="CG" unit="M"><x>0</x><y>0</y><z>0</z></location>
  </mass_balance>
  <ground_reactions>
    <contact type="BOGEY" name="NOSE"><location unit="M"><x>-1.25</x><y>0</y><z>-2.05</z></location><static_friction>0.85</static_friction><dynamic_friction>0.65</dynamic_friction><rolling_friction>0.025</rolling_friction><spring_coeff unit="N/M">180000</spring_coeff><damping_coeff unit="N/M/SEC">22000</damping_coeff><max_steer unit="DEG">18</max_steer><brake_group>NONE</brake_group><retractable>0</retractable></contact>
    <contact type="BOGEY" name="LEFT_MAIN"><location unit="M"><x>1.25</x><y>-1.35</y><z>-2.05</z></location><static_friction>0.85</static_friction><dynamic_friction>0.65</dynamic_friction><rolling_friction>0.025</rolling_friction><spring_coeff unit="N/M">220000</spring_coeff><damping_coeff unit="N/M/SEC">26000</damping_coeff><max_steer unit="DEG">0</max_steer><brake_group>LEFT</brake_group><retractable>0</retractable></contact>
    <contact type="BOGEY" name="RIGHT_MAIN"><location unit="M"><x>1.25</x><y>1.35</y><z>-2.05</z></location><static_friction>0.85</static_friction><dynamic_friction>0.65</dynamic_friction><rolling_friction>0.025</rolling_friction><spring_coeff unit="N/M">220000</spring_coeff><damping_coeff unit="N/M/SEC">26000</damping_coeff><max_steer unit="DEG">0</max_steer><brake_group>RIGHT</brake_group><retractable>0</retractable></contact>
    <contact type="STRUCTURE" name="FUSELAGE_BOTTOM"><location unit="M"><x>0</x><y>0</y><z>-1.95</z></location><static_friction>0.3</static_friction><dynamic_friction>0.3</dynamic_friction><spring_coeff unit="N/M">350000</spring_coeff><damping_coeff unit="N/M/SEC">35000</damping_coeff></contact>
  </ground_reactions>
  <propulsion>
    <engine file="BC001-Turbojet"><feed>0</feed><thruster file="direct"><location unit="M"><x>1.75</x><y>0</y><z>0</z></location><orient unit="DEG"><roll>0</roll><pitch>0</pitch><yaw>0</yaw></orient></thruster></engine>
    <tank type="FUEL" number="0"><location unit="M"><x>0</x><y>0</y><z>0</z></location><capacity unit="KG">900</capacity><contents unit="KG">900</contents></tank>
  </propulsion>
  <flight_control name="BC-001">
    <channel name="Pitch"><pure_gain name="fcs/elevator-pos-rad"><input>fcs/elevator-cmd-norm</input><gain>0.35</gain><output>fcs/elevator-pos-rad</output></pure_gain></channel>
    <channel name="Roll"><pure_gain name="fcs/aileron-pos-rad"><input>fcs/aileron-cmd-norm</input><gain>0.35</gain><output>fcs/aileron-pos-rad</output></pure_gain></channel>
    <channel name="Yaw"><pure_gain name="fcs/rudder-pos-rad"><input>fcs/rudder-cmd-norm</input><gain>0.30</gain><output>fcs/rudder-pos-rad</output></pure_gain></channel>
    <channel name="Speedbrake"><pure_gain name="fcs/speedbrake-pos-norm"><input>fcs/speedbrake-cmd-norm</input><gain>1.0</gain><output>fcs/speedbrake-pos-norm</output></pure_gain></channel>
  </flight_control>
  <aerodynamics>
    <axis name="LIFT"><function name="aero/coefficient/CLalpha"><description>Small body lift approximation for a wingless cube</description><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><table><independentVar lookup="row">aero/alpha-rad</independentVar><tableData>-1.2 -0.45
-0.5 -0.22
0.0 0.0
0.5 0.22
1.2 0.45</tableData></table></product></function></axis>
    <axis name="DRAG">
      <function name="aero/coefficient/CD0"><description>High drag from cubic fuselage</description><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><table><independentVar lookup="row">aero/alpha-rad</independentVar><tableData>-1.57 1.65
-0.5 1.25
0.0 1.05
0.5 1.25
1.57 1.65</tableData></table></product></function>
      <function name="aero/coefficient/CDmach"><description>Additional compressibility drag</description><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><table><independentVar lookup="row">velocities/mach</independentVar><tableData>0.0 0.0
0.8 0.05
1.0 0.25
1.5 0.18
3.0 0.12
6.0 0.10
10.0 0.10</tableData></table></product></function>
      <function name="aero/coefficient/CDsb"><description>Parachute and speedbrake drag</description><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>fcs/speedbrake-pos-norm</property><value>2.8</value></product></function>
    </axis>
    <axis name="SIDE"><function name="aero/coefficient/CYb"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>aero/beta-rad</property><value>-0.35</value></product></function></axis>
    <axis name="ROLL"><function name="aero/coefficient/Clb"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>aero/beta-rad</property><value>-0.025</value></product></function><function name="aero/coefficient/Clp"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>aero/bi2vel</property><property>velocities/p-aero-rad_sec</property><value>-0.12</value></product></function><function name="aero/coefficient/Clda"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>fcs/aileron-pos-rad</property><value>0.12</value></product></function></axis>
    <axis name="PITCH"><function name="aero/coefficient/Cmalpha"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/cbarw-ft</property><property>aero/alpha-rad</property><value>-0.08</value></product></function><function name="aero/coefficient/Cmq"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/cbarw-ft</property><property>aero/ci2vel</property><property>velocities/q-aero-rad_sec</property><value>-2.0</value></product></function><function name="aero/coefficient/Cmde"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/cbarw-ft</property><property>fcs/elevator-pos-rad</property><value>-0.28</value></product></function></axis>
    <axis name="YAW"><function name="aero/coefficient/Cnb"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>aero/beta-rad</property><value>0.025</value></product></function><function name="aero/coefficient/Cnr"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>aero/bi2vel</property><property>velocities/r-aero-rad_sec</property><value>-0.12</value></product></function><function name="aero/coefficient/Cndr"><product><property>aero/qbar-psf</property><property>metrics/Sw-sqft</property><property>metrics/bw-ft</property><property>fcs/rudder-pos-rad</property><value>0.08</value></product></function></axis>
  </aerodynamics>
</fdm_config>