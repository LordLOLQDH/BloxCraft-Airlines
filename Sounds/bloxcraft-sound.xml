<?xml version="1.0"?>
<PropertyList>
  <fx>
    <engine-start>
      <name>bc-engine-start</name>
      <path>Aircraft/BloxCraft-Airlines/Sounds/engine-start.ogg</path>
      <mode>once</mode>
      <property>/bloxcraft/sound/engine-start</property>
    </engine-start>
    <engine-stop>
      <name>bc-engine-stop</name>
      <path>Aircraft/BloxCraft-Airlines/Sounds/engine-stop.ogg</path>
      <mode>once</mode>
      <property>/bloxcraft/sound/engine-stop</property>
    </engine-stop>
    <engine-loop>
      <name>bc-engine-loop</name>
      <path>Aircraft/BloxCraft-Airlines/Sounds/engine-loop.ogg</path>
      <mode>looped</mode>
      <property>/bloxcraft/engine-running</property>
    </engine-loop>
    <radio>
      <name>bc-radio</name>
      <path>Aircraft/BloxCraft-Airlines/Sounds/radio-song.ogg</path>
      <mode>looped</mode>
      <property>/bloxcraft/radio-enabled</property>
    </radio>
  </fx>
</PropertyList>