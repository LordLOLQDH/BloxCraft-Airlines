<?xml version="1.0"?>
<PropertyList>
  <sim>
    <description>BloxCraft Airlines BC-001</description><author>BloxCraft Airlines</author><status>Development</status><aircraft-version>0.2</aircraft-version>
    <flight-model>jsb</flight-model><aero>BC-001</aero>
    <model><path>Aircraft/BloxCraft-Airlines/Models/bloxcraft.xml</path></model>
    <sound><path>Aircraft/BloxCraft-Airlines/Sounds/bloxcraft-sound.xml</path></sound>
    <chase-distance-m>-18</chase-distance-m>
  </sim>
  <input><keyboard>
    <key n="i"><name>Engine start / stop</name><binding><command>nasal</command><script>BloxCraft.toggleEngine();</script></binding></key>
    <key n="a"><name>Afterburner</name><binding><command>nasal</command><script>BloxCraft.toggleAfterburner();</script></binding></key>
    <key n="h"><name>Release wheels</name><binding><command>nasal</command><script>BloxCraft.dropWheels();</script></binding></key>
    <key n="g"><name>Deploy landing cushion</name><binding><command>nasal</command><script>BloxCraft.deployCushion();</script></binding></key>
    <key n="p"><name>Deploy parachute</name><binding><command>nasal</command><script>BloxCraft.deployParachute();</script></binding></key>
    <key n="e"><name>Simulate engine failure</name><binding><command>nasal</command><script>BloxCraft.engineFailure();</script></binding></key>
    <key n="r"><name>Radio / disco mode</name><binding><command>nasal</command><script>BloxCraft.toggleDisco();</script></binding></key>
  </keyboard></input>
  <nasal><BloxCraft><file>Aircraft/BloxCraft-Airlines/Nasal/bloxcraft.nas</file></BloxCraft></nasal>
</PropertyList>